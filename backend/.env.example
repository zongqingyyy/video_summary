# ===== 语音识别（ASR）=====
# 可选：tiny / base / small / medium / large-v3（越大越准也越慢）
WHISPER_MODEL=small
# auto / cpu / cuda
WHISPER_DEVICE=auto
# int8 / float16 / float32
WHISPER_COMPUTE=int8
# auto（自动识别，推荐）/ zh / en
LANGUAGE=auto
VAD_FILTER=True

# ===== 摘要（LLM，可选）=====
# 留空则使用本地抽取式摘要（英文视频的摘要保持英文原文）
# 默认对接智谱 GLM-4-Flash，密钥申请：https://open.bigmodel.cn/usercenter/apikeys
# 填入后有两点变化：1) 摘要由大模型生成；2) 无论中文还是英文视频，输出统一为简体中文
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TIMEOUT=120
USE_LOCAL_FALLBACK=True

# ===== 链接下载（yt-dlp）=====
# 抖音走无头浏览器解析（douyin.py），无需 cookies；
# 下面的配置只用于 B 站等需要登录态（会员/充电专属）的场景，一般留空即可。
COOKIES_FROM_BROWSER=

# cookies.txt 绝对路径（可选，需要时把导出的文件放到该位置）
COOKIES_FILE=

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
